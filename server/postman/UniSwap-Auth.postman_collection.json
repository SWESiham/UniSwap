              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "name": "POST /api/auth/forgot-password"
        },
        {
          "request": {
            "method": "POST",
            "body": {
              "raw": "{\"token\":\"TOKEN_FROM_EMAIL\",\"password\":\"NEW_PASSWORD\"}",
              "mode": "raw"
