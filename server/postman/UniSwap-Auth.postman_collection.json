                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "name": "POST /api/auth/logout"
        },
        {
          "request": {
            "method": "POST",
            "body": {
              "raw": "{\"email\":\"ADMIN_EMAIL\",\"password\":\"ADMIN_PASSWORD\"}",
              "mode": "raw"
            },
            "url": "{{baseUrl}}/api/auth/admin/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
