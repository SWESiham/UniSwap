              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "name": "GET /api/users/me/listings"
        },
        {
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me/sold",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "name": "GET /api/users/me/sold"
        },
        {
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me/favorites",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "name": "GET /api/users/me/favorites"
        },
        {
          "request": {
            "method": "PATCH",
            "body": {
              "raw": "{\"currentPassword\":\"CURRENT\",\"newPassword\":\"NEW_PASSWORD\"}",
              "mode": "raw"
            },
            "url": "{{baseUrl}}/api/auth/change-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "name": "PATCH /api/auth/change-password"
        },
        {
          "request": {
            "method": "POST",
            "body": {
              "raw": "{\"email\":\"YOUR_EMAIL\"}",
              "mode": "raw"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "header": [
              {
                "key": "Content-Type",
